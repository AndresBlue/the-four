[resource]
resource_name = "WardrobeInside"
; The inside of the doors (tools/props/build_wardrobe.gd, BOARD_UV): no
; normal map. Where the board takes its wood, the model's map leans well to
; one side, and the board caught the room's light through the gap and the
; door's shadow with it, in stripes.
; Anisotropic: the graphics preset sets its level (Viewport.anisotropic_filtering_level).
texture_filter = 5
; The model is single-sided; the inside of the doors must render when hiding.
cull_mode = 2
albedo_color = Color(0.78, 0.7, 0.62, 1)
albedo_texture = ExtResource("1")
metallic = 1.0
metallic_texture = ExtResource("4")
roughness_texture = ExtResource("3")
ao_enabled = true
ao_texture = ExtResource("5")

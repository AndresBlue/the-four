extends SceneTree
## Finds the individual grunts in assets/audio/sfx/chase/grunts.ogg by
## rendering it through the mixer (real time) and writes
## game/audio/grunt_segments.gd. Run headless after replacing the recording.
const SOURCE := "res://assets/audio/sfx/chase/grunts.ogg"
const WINDOW := 0.02

func _initialize() -> void: run.call_deferred()

func run() -> void:
	AudioServer.add_bus()
	var bus := AudioServer.bus_count - 1
	AudioServer.set_bus_name(bus, "Analysis")
	var capture := AudioEffectCapture.new()
	capture.buffer_length = 10.0
	AudioServer.add_bus_effect(bus, capture)
	var player := AudioStreamPlayer.new()
	player.bus = "Analysis"
	var stream: AudioStream = load(SOURCE)
	player.stream = stream
	root.add_child(player)
	player.play()
	var frames := PackedVector2Array()
	var waited := 0.0
	while waited < stream.get_length() + 0.3:
		await process_frame
		waited += get_root().get_process_delta_time()
		frames.append_array(capture.get_buffer(capture.get_frames_available()))
	var rate := AudioServer.get_mix_rate()
	var window := int(rate * WINDOW)
	var energies: Array[float] = []
	var loudest := 0.0
	for start in range(0, frames.size() - window, window):
		var sum := 0.0
		for i in window: sum += frames[start + i].length_squared()
		energies.append(sqrt(sum / window))
		loudest = maxf(loudest, energies[-1])
	var threshold := loudest * 0.12
	var segments: Array = []
	var begin := -1
	for i in energies.size():
		if energies[i] > threshold and begin < 0: begin = i
		elif energies[i] <= threshold and begin >= 0:
			if (i - begin) * WINDOW > 0.15: segments.append([begin, i])
			begin = -1
	if begin >= 0: segments.append([begin, energies.size()])
	var merged: Array = []
	for segment in segments:
		if not merged.is_empty() and (segment[0] - merged[-1][1]) * WINDOW < 0.12: merged[-1][1] = segment[1]
		else: merged.append(segment)
	var lines := PackedStringArray(["extends RefCounted", "## Generated by tools/audio/analyze_grunts.gd — do not edit by hand.", "## Individual grunts inside assets/audio/sfx/chase/grunts.ogg: [start, length] in seconds.", "const SEGMENTS := ["])
	for segment in merged:
		var start := maxf(0.0, segment[0] * WINDOW - 0.03)
		lines.append("\t[%.3f, %.3f]," % [start, segment[1] * WINDOW - start + 0.08])
	lines.append("]")
	var file := FileAccess.open("res://game/audio/grunt_segments.gd", FileAccess.WRITE)
	file.store_string("\n".join(lines) + "\n")
	file.close()
	print("GRUNTS ", merged.size(), " length=", stream.get_length())
	quit()

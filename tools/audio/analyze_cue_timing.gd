extends SceneTree
## Measures where each effect really starts (onset) and where its main hit is
## (peak) by rendering it through the mixer. Writes game/audio/cue_timing.gd so
## playback can skip leading silence without editing the recordings.
## Real time: run with --headless; takes roughly the total length of the clips.
const ROOTS := ["res://assets/audio/sfx/door", "res://assets/audio/sfx/wardrobe", "res://assets/audio/sfx/paper", "res://assets/audio/sfx/heartbeat"]
const WINDOW := 0.01

func _initialize() -> void: run.call_deferred()

func collect(path: String, out: Array) -> void:
	var dir := DirAccess.open(path)
	for sub in dir.get_directories(): collect(path + "/" + sub, out)
	for file in dir.get_files():
		if file.get_extension() in ["ogg", "mp3", "wav"]: out.append(path + "/" + file)

func run() -> void:
	var files: Array = []
	for root_path in ROOTS: collect(root_path, files)
	files.sort()
	AudioServer.add_bus()
	var bus := AudioServer.bus_count - 1
	AudioServer.set_bus_name(bus, "Analysis")
	AudioServer.set_bus_mute(bus, false)
	var capture := AudioEffectCapture.new()
	capture.buffer_length = 10.0
	AudioServer.add_bus_effect(bus, capture)
	var player := AudioStreamPlayer.new()
	player.bus = "Analysis"
	root.add_child(player)
	var rate := AudioServer.get_mix_rate()
	var results := {}
	for path in files:
		var stream: AudioStream = load(path)
		capture.clear_buffer()
		player.stream = stream
		player.play()
		var frames := PackedVector2Array()
		var waited := 0.0
		while waited < stream.get_length() + 0.3:
			await process_frame
			waited += get_root().get_process_delta_time()
			frames.append_array(capture.get_buffer(capture.get_frames_available()))
		player.stop()
		frames.append_array(capture.get_buffer(capture.get_frames_available()))
		var window := int(rate * WINDOW)
		var energies: Array[float] = []
		var loudest := 0.0
		var peak_index := 0
		for start in range(0, frames.size() - window, window):
			var sum := 0.0
			for i in window: sum += frames[start + i].length_squared()
			var rms := sqrt(sum / window)
			energies.append(rms)
			if rms > loudest:
				loudest = rms
				peak_index = energies.size() - 1
		# Onset: first window within -24 dB of the loudest one.
		var onset_index := 0
		for i in energies.size():
			if energies[i] > loudest * 0.063:
				onset_index = i
				break
		var onset := onset_index * WINDOW
		var peak := peak_index * WINDOW
		results[path] = {"onset_window": onset, "peak_window": peak, "loudest": loudest, "length": stream.get_length()}
		print(path.get_file(), " onset=", onset, " peak=", peak, " rms=", loudest)
	# Mixer latency: a synthetic click that starts at sample zero.
	var click := AudioStreamWAV.new()
	click.format = AudioStreamWAV.FORMAT_16_BITS
	click.mix_rate = 44100
	var bytes := PackedByteArray()
	bytes.resize(44100)
	for i in 22050: bytes.encode_s16(i * 2, 20000 if i < 2205 else 0)
	click.data = bytes
	capture.clear_buffer()
	player.stream = click
	player.play()
	var latency_frames := PackedVector2Array()
	for i in 40:
		await process_frame
		latency_frames.append_array(capture.get_buffer(capture.get_frames_available()))
	var latency := 0.0
	for i in latency_frames.size():
		if latency_frames[i].length() > 0.1:
			latency = float(i) / rate
			break
	print("LATENCY ", latency)
	var lines := PackedStringArray()
	lines.append("extends RefCounted")
	lines.append("## Generated by tools/audio/analyze_cue_timing.gd — do not edit by hand.")
	lines.append("## onset: seconds of leading silence; hit: seconds to the loudest moment.")
	lines.append("const TIMING := {")
	for path in results:
		var data: Dictionary = results[path]
		var onset := maxf(0.0, data.onset_window - latency - 0.01)
		var hit := maxf(onset, data.peak_window - latency)
		lines.append("\t\"%s\": {\"onset\": %.3f, \"hit\": %.3f}," % [path, onset, hit])
	lines.append("}")
	lines.append("")
	lines.append("static func onset(path: String) -> float: return TIMING.get(path, {}).get(\"onset\", 0.0)")
	lines.append("static func hit(path: String) -> float: return TIMING.get(path, {}).get(\"hit\", 0.0)")
	var file := FileAccess.open("res://game/audio/cue_timing.gd", FileAccess.WRITE)
	file.store_string("\n".join(lines) + "\n")
	file.close()
	quit()

; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="THE FOUR — Hotel"
run/main_scene="res://game/app/hotel.tscn"
config/project_settings_override="user://renderer.cfg"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.02, 0.02, 0.017, 1)
boot_splash/show_image=false
config/icon="res://assets/images/the_four.png"

[audio]

general/3d_panning_strength=0.9

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_render/layer_2="Local player body (hidden by own camera)"
3d_physics/layer_1="Architecture"
3d_physics/layer_3="Players"
3d_physics/layer_4="Closed doors"
3d_physics/layer_5="Hiding interactions"
3d_physics/layer_6="Creatures"
3d_physics/layer_7="Door sight occlusion"
3d_physics/layer_10="Audio areas"

[physics]

3d/default_gravity=20.0

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.025, 0.026, 0.021, 1)
occlusion_culling/use_occlusion_culling=true

[shader_globals]

surface_detail={
"type": "float",
"value": 4.0
}

[steam]

initialization/app_data/app_id=480
initialization/processes/initialize_on_startup=true
